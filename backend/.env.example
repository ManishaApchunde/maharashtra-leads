# Copy this file to .env and fill in real values. Never commit .env.

# MySQL 8 connection (matches docker-compose.yml defaults). Keep ?charset=utf8mb4 for Marathi text.
DATABASE_URL=mysql+pymysql://leads:leads@localhost:3306/maharashtra_leads?charset=utf8mb4

# Optional: if set, every API request must send header  X-API-Key: <value>
API_KEY=

# Optional: Google Places API (New) keys for the Data Collection page - ONE line, comma-separated.
# Keys are tried in order; the next key is used only when Google rejects a key (invalid, restricted,
# API not enabled / billing off on that key's project). Quota and rate limits never switch keys:
# the district job pauses and resumes later. The old single GOOGLE_PLACES_API_KEY= line still works.
# Read Google Maps Platform terms on storing Places data before using it.
GOOGLE_PLACES_API_KEYS=NEW_KEY_1,NEW_KEY_2,NEW_KEY_3

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Records not verified for this many days count as "old" on the Data Quality page
OLD_RECORD_DAYS=180
